#include <iostream>
#include<string>
using namespace std;
struct Student
{
    int rollNo;
    string name;
    float percentage;
};
int main()
{
    Student s[100];
    int n;
    cout<<"Enter number of students:";
    cin>>n;
    for(int i=0;i<n;i++)
        {
            cout<<"\nEnter Details of Student"<<i+1<<endl;
            cout<<"Enter Roll Number:";
            cin>>s[i].percentage;
            
        }
    cout<<"\n----Student Records----\n";
    cout<<"Roll No.\tName\t\tPercentage\n";
    for(int i=0;i<n;i++)
        {
            cout<<s[i].rollNo<<"\t\t"<<s[i].name<<"\t\t"<<s[i].percentage<<"%/n";
        }
    return 0;
}
